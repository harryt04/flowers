# MongoDB connection string pointing to a cluster
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Resend API key used to send contact-form notification emails
RESEND_API_KEY=

# Inbox that should receive contact-form notification emails
CONTACT_NOTIFICATION_EMAIL=

# Optional: verified "from" address (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=
